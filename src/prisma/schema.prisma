generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  email        String  @unique
  passwordHash String
  role         Role    @default(EMPLOYEE)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts      Shift[]
  shiftAudits ShiftAudit[]
}

model Shift {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  clockIn  DateTime
  clockOut DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits ShiftAudit[]

  @@index([userId])
  @@index([clockIn])
}

model ShiftAudit {
  id String @id @default(cuid())

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  changedById String
  changedBy   User   @relation(fields: [changedById], references: [id])

  previousClockIn  DateTime?
  previousClockOut DateTime?
  newClockIn       DateTime?
  newClockOut      DateTime?

  reason    String
  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([changedById])
}